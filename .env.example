# Digital Complaint Management System - Environment Variables

# Flask App Secret Key (used for sessions and security)
# Generate a secure key for production (e.g., using `python -c "import secrets; print(secrets.token_hex(16))"`)
SECRET_KEY=your_super_secret_key_here

# Database Configuration (Optional, defaults to local SQLite if not set)
# Examples:
# DATABASE_URL=sqlite:///database/complaints.db
# DATABASE_URL=postgresql://user:password@localhost/dbname
# DATABASE_URL=mysql+pymysql://user:password@localhost/dbname
DATABASE_URL=sqlite:///database/complaints.db

# Flask Environment (development or production)
FLASK_ENV=development
FLASK_DEBUG=1
